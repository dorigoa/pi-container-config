#!/usr/bin/env bash
# pi-box — runs Pi (coding agent) inside an isolated container, connected to a
# local model served by an OpenAI-compatible inference engine
# (llama.cpp, vLLM, Ollama, LM Studio, ...).
#
# Supported runtimes:
#   macOS  -> Apple `container` (https://github.com/apple/container)
#   Linux  -> podman (preferred) or docker
#
# Compatible with macOS's bash 3.2.
#
# Version 1.2 (2026-10-08)
#   - Full development image: C/C++ (gcc, clang, cmake, gdb, valgrind,
#     common libraries) and Python (numpy, scipy, pygame, logzero, ...) in a
#     virtual environment that also accepts `pip install`.
#   - APT_EXTRA and PIP_PACKAGES in pi-box.conf to add packages.
#   - The image is rebuilt automatically when the Containerfile, the base
#     image or the package lists change; --rebuild rebuilds it from scratch.
#   - --reset-config rewrites pi-box.conf with the default values.
# Version 1.1
#   - Linux: --cpus/--memory only if the kernel provides the cgroup
#     controllers; --memory-swap equal to --memory. "localhost" -> 127.0.0.1.
set -euo pipefail

PI_BOX_VERSION="1.2"
PI_BOX_HOME="${PI_BOX_HOME:-$HOME/pi-container}"
CGROUP_ROOT="${PI_BOX_CGROUP_ROOT:-/sys/fs/cgroup}"   # override for testing only
CONF_FILE="$PI_BOX_HOME/pi-box.conf"
AGENT_DIR="$PI_BOX_HOME/agent"
IMAGE_DIR="$PI_BOX_HOME/image"
STAMP_FILE="$IMAGE_DIR/.build-stamp"

die()  { printf 'pi-box: ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf 'pi-box: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Defaults (overridden by pi-box.conf, then by command-line options)
# ---------------------------------------------------------------------------
BASE_URL="http://127.0.0.1:8080/v1"   # inference engine URL AS SEEN FROM THE HOST
MODEL_ID=""                           # empty = auto-detect from /v1/models
MODEL_NAME=""                         # name shown in Pi (default = MODEL_ID)
API_KEY="local"                       # dummy key for local servers without authentication
CONTEXT_WINDOW=32768                  # must match the server's context size
MAX_TOKENS=8192                       # max tokens per reply
REASONING=false                       # true if the model supports "thinking"
THINKING=off                          # off|minimal|low|medium|high|xhigh|max
IMAGES=false                          # true if the model accepts images
TEMPERATURE=""                        # empty = server default
TOP_P=""
TOP_K=""
CPUS=4                                # empty = no limit
MEMORY=4g                             # empty = no limit
OFFLINE=true                          # disables Pi's automatic network activity
IMAGE="pi-box:latest"
PI_VERSION="latest"                   # Pi npm version to install in the image
BASE_IMAGE="node:24-slim"             # base image (Debian + Node.js)
APT_EXTRA=""                          # extra Debian packages
PIP_PACKAGES="ruff mypy rich tqdm click httpx ipython"   # extra pip packages

write_default_conf() {
  mkdir -p "$PI_BOX_HOME"
  cat > "$CONF_FILE" <<'EOF'
# pi-box configuration (bash syntax). Command-line options take precedence
# over these values.

# --- Model and inference engine ------------------------------------------------
BASE_URL="http://127.0.0.1:8080/v1"   # inference engine URL as seen from the host
MODEL_ID=""                           # empty = auto-detect
MODEL_NAME=""
API_KEY="local"
CONTEXT_WINDOW=32768
MAX_TOKENS=8192
REASONING=false                       # true for thinking models
THINKING=off                          # off|minimal|low|medium|high|xhigh|max
IMAGES=false
TEMPERATURE=""
TOP_P=""
TOP_K=""

# --- Container ----------------------------------------------------------------
CPUS=4                                # "" = no limit
MEMORY=4g                             # "" = no limit
OFFLINE=true

# --- Image (changing these triggers an automatic rebuild) --------------------
IMAGE="pi-box:latest"
PI_VERSION="latest"
BASE_IMAGE="node:24-slim"             # e.g. node:24-trixie-slim to pin Debian 13
# Extra Debian packages, space-separated (e.g. "libopencv-dev octave")
APT_EXTRA=""
# Extra pip packages, installed into /opt/venv (e.g. "polars torch==2.5.1")
PIP_PACKAGES="ruff mypy rich tqdm click httpx ipython"
EOF
  info "wrote configuration file $CONF_FILE"
}

usage() {
  cat <<'EOF'
Usage: pi-box [options] [-- extra arguments for pi]

Model and inference engine
  -u, --base-url URL      inference engine URL as seen from the host
                          (e.g. http://127.0.0.1:8080/v1, http://192.168.1.20:8000/v1)
  -m, --model ID          model id (default: detected from URL/models)
  -n, --name NAME         name shown in Pi
  -c, --ctx N             context window in tokens
  -o, --max-tokens N      max tokens per reply
  -r, --reasoning on|off  the model supports thinking
  -t, --thinking LEVEL    off|minimal|low|medium|high|xhigh|max
  -i, --images            the model accepts images
      --no-images         text only
      --temperature X     sampling parameters (optional)
      --top-p X
      --top-k N
      --api-key KEY       if the server requires a key

Container
  -p, --project DIR       project folder mounted at /work (default: current folder)
      --cpus N            CPU limit ("" = none)
      --memory M          RAM limit, e.g. 4g ("" = none)
      --rebuild           rebuild the image from scratch (no cache), then start
      --build-only        (re)build the image if needed, then exit
      --shell             open a bash shell in the container instead of Pi
      --dry-run           show configuration and command without running anything
      --reset-config      rewrite pi-box.conf with defaults (keeps a backup), then exit
      --force             allow mounting the home folder or / (not recommended)
  -V, --version           pi-box version
  -h, --help              this help

Examples
  pi-box
  pi-box -m gemma-4-26b-a4b-it -i -c 65536
  pi-box -u http://192.168.1.20:8000/v1 -m qwen3.6-27b -r on -t high -p ~/src/project
  pi-box --rebuild --build-only
  pi-box -- --continue
EOF
}

# --version, --help and --reset-config are handled before reading (or creating)
# the configuration file, which might even be broken
for a in "$@"; do
  [ "$a" = "--" ] && break
  case "$a" in
    -V|--version) printf 'pi-box %s\n' "$PI_BOX_VERSION"; exit 0 ;;
    -h|--help)    NEED_HELP=true ;;
  esac
  if [ "$a" = "--reset-config" ]; then
    if [ -f "$CONF_FILE" ]; then
      bak="$CONF_FILE.bak-$(date +%Y%m%d-%H%M%S)"
      cp -p "$CONF_FILE" "$bak"
      info "backup of the previous configuration: $bak"
    fi
    write_default_conf
    exit 0
  fi
done

if [ "${NEED_HELP:-false}" = true ]; then usage; exit 0; fi

if [ -f "$CONF_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONF_FILE"
else
  write_default_conf
fi


need_arg() { [ "$#" -ge 2 ] && [ -n "$2" ] || die "option $1 requires a value"; }

PROJECT="$PWD"
DO_REBUILD=false
BUILD_ONLY=false
DO_SHELL=false
DRY_RUN=false
FORCE=false
PI_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    -u|--base-url)   need_arg "$@"; BASE_URL="$2"; shift 2 ;;
    -m|--model)      need_arg "$@"; MODEL_ID="$2"; shift 2 ;;
    -n|--name)       need_arg "$@"; MODEL_NAME="$2"; shift 2 ;;
    -c|--ctx)        need_arg "$@"; CONTEXT_WINDOW="$2"; shift 2 ;;
    -o|--max-tokens) need_arg "$@"; MAX_TOKENS="$2"; shift 2 ;;
    -r|--reasoning)  need_arg "$@"; REASONING="$2"; shift 2 ;;
    -t|--thinking)   need_arg "$@"; THINKING="$2"; shift 2 ;;
    -i|--images)     IMAGES=true; shift ;;
    --no-images)     IMAGES=false; shift ;;
    --temperature)   need_arg "$@"; TEMPERATURE="$2"; shift 2 ;;
    --top-p)         need_arg "$@"; TOP_P="$2"; shift 2 ;;
    --top-k)         need_arg "$@"; TOP_K="$2"; shift 2 ;;
    --api-key)       need_arg "$@"; API_KEY="$2"; shift 2 ;;
    -p|--project)    need_arg "$@"; PROJECT="$2"; shift 2 ;;
    --cpus)          [ "$#" -ge 2 ] || die "--cpus requires a value"; CPUS="$2"; shift 2 ;;
    --memory)        [ "$#" -ge 2 ] || die "--memory requires a value"; MEMORY="$2"; shift 2 ;;
    --rebuild)       DO_REBUILD=true; shift ;;
    --build-only)    BUILD_ONLY=true; shift ;;
    --shell)         DO_SHELL=true; shift ;;
    --dry-run)       DRY_RUN=true; shift ;;
    --force)         FORCE=true; shift ;;
    -V|--version)    printf 'pi-box %s\n' "$PI_BOX_VERSION"; exit 0 ;;
    -h|--help)       usage; exit 0 ;;
    --)              shift; PI_ARGS=("$@"); break ;;
    *)               die "unknown option: $1 (see --help)" ;;
  esac
done

# ---------------------------------------------------------------------------
# Validation (values end up in JSON and in the Containerfile: no dangerous
# characters allowed)
# ---------------------------------------------------------------------------
re_url='^https?://[^"\\[:space:]]+$'
re_int='^[0-9]+$'
re_num='^[0-9]+(\.[0-9]+)?$'
re_id='^[A-Za-z0-9._:/@+-]+$'
re_mem='^[0-9]+[kKmMgG]?$'
re_safe='^[^"\\]*$'
re_image='^[A-Za-z0-9._/:@-]+$'
re_pkgs='^[]A-Za-z0-9._+=<>!~,:@/ [-]*$'

[[ $BASE_URL =~ $re_url ]]       || die "invalid base URL: $BASE_URL"
[[ $CONTEXT_WINDOW =~ $re_int ]] || die "--ctx must be an integer"
[[ $MAX_TOKENS =~ $re_int ]]     || die "--max-tokens must be an integer"
[ "$MAX_TOKENS" -lt "$CONTEXT_WINDOW" ] || die "--max-tokens must be less than --ctx"
[[ $API_KEY =~ $re_safe ]]       || die "the API key cannot contain \" or \\"
[ -z "$TEMPERATURE" ] || [[ $TEMPERATURE =~ $re_num ]] || die "invalid --temperature"
[ -z "$TOP_P" ]       || [[ $TOP_P =~ $re_num ]]       || die "invalid --top-p"
[ -z "$TOP_K" ]       || [[ $TOP_K =~ $re_int ]]       || die "invalid --top-k"
[ -z "$CPUS" ]        || [[ $CPUS =~ $re_int ]]        || die "--cpus must be an integer"
[ -z "$MEMORY" ]      || [[ $MEMORY =~ $re_mem ]]      || die "invalid --memory (e.g. 4g)"
[[ $IMAGE =~ $re_image ]]        || die "invalid IMAGE: $IMAGE"
[[ $BASE_IMAGE =~ $re_image ]]   || die "invalid BASE_IMAGE: $BASE_IMAGE"
[[ $PI_VERSION =~ $re_id ]]      || die "invalid PI_VERSION: $PI_VERSION"
[[ $APT_EXTRA =~ $re_pkgs ]]     || die "APT_EXTRA contains characters that are not allowed"
[[ $PIP_PACKAGES =~ $re_pkgs ]]  || die "PIP_PACKAGES contains characters that are not allowed"

case "$REASONING" in
  on|true|yes|1)   REASONING=true ;;
  off|false|no|0)  REASONING=false ;;
  *) die "--reasoning accepts on|off" ;;
esac
case "$THINKING" in
  off|minimal|low|medium|high|xhigh|max) ;;
  *) die "--thinking accepts off|minimal|low|medium|high|xhigh|max" ;;
esac
if [ "$REASONING" = false ] && [ "$THINKING" != off ]; then
  info "warning: thinking=$THINKING but reasoning=off -> Pi will lower it to 'off'"
fi

if [ "$BUILD_ONLY" = false ]; then
  [ -d "$PROJECT" ] || die "project folder does not exist: $PROJECT"
  PROJECT="$(cd "$PROJECT" && pwd -P)"
  HOME_REAL="$(cd "$HOME" && pwd -P)"
  if [ "$FORCE" = false ]; then
    case "$PROJECT" in
      /|"$HOME_REAL") die "mounting $PROJECT would defeat the isolation; use a subfolder or --force" ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------
# Container runtime
# ---------------------------------------------------------------------------
if [ -n "${PI_BOX_RUNTIME:-}" ]; then
  RT="$PI_BOX_RUNTIME"
else
  case "$(uname -s)" in
    Darwin) RT=container ;;
    Linux)
      if command -v podman >/dev/null 2>&1; then RT=podman
      elif command -v docker >/dev/null 2>&1; then RT=docker
      else die "no runtime found: install podman (sudo apt install podman) or docker"
      fi ;;
    *) die "unsupported operating system: $(uname -s)" ;;
  esac
fi
case "$RT" in container|podman|docker) ;; *) die "unsupported runtime: $RT" ;; esac
if [ "$DRY_RUN" = false ]; then
  command -v "$RT" >/dev/null 2>&1 || die "command '$RT' not found"
fi

# On macOS the container cannot see the Mac's localhost: the domain
# host.container.internal is used instead. On Linux the host network is used
# (--network host); "localhost" becomes 127.0.0.1 because Node might resolve it
# to ::1 (IPv6) and miss a server listening on IPv4 only.
CONTAINER_BASE_URL="$BASE_URL"
if [ "$RT" = container ]; then
  re_loop='^(https?://)(127\.0\.0\.1|localhost|\[::1\])([:/].*)?$'
  if [[ $BASE_URL =~ $re_loop ]]; then
    CONTAINER_BASE_URL="${BASH_REMATCH[1]}host.container.internal${BASH_REMATCH[3]}"
  fi
else
  re_lh='^(https?://)localhost([:/].*)?$'
  if [[ $BASE_URL =~ $re_lh ]]; then
    CONTAINER_BASE_URL="${BASH_REMATCH[1]}127.0.0.1${BASH_REMATCH[2]}"
  fi
fi

# ---------------------------------------------------------------------------
# Model: auto-detect if not specified
# ---------------------------------------------------------------------------
detect_model() {
  command -v curl >/dev/null 2>&1 || return 1
  local body
  body="$(curl -fsS --max-time 5 "${BASE_URL%/}/models")" || return 1
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$body" | jq -r '.data[0].id // empty'
  else
    printf '%s' "$body" | tr ',' '\n' | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
  fi
}

if [ "$BUILD_ONLY" = false ]; then
  if [ -z "$MODEL_ID" ]; then
    MODEL_ID="$(detect_model || true)"
    [ -n "$MODEL_ID" ] || die "cannot detect the model from ${BASE_URL%/}/models: specify it with --model"
    info "detected model: $MODEL_ID"
  fi
  [[ $MODEL_ID =~ $re_id ]] || die "invalid model id: $MODEL_ID"
  [ -n "$MODEL_NAME" ] || MODEL_NAME="$MODEL_ID"
  [[ $MODEL_NAME =~ $re_safe ]] || die "the model name cannot contain \" or \\"
fi

# ---------------------------------------------------------------------------
# Pi configuration files (regenerated on every run)
# ---------------------------------------------------------------------------
models_json() {
  local input='["text"]' sampling="" extra=""
  if [ "$IMAGES" = true ]; then input='["text", "image"]'; fi
  if [ -n "$TEMPERATURE" ]; then sampling="${sampling:+$sampling, }\"temperature\": $TEMPERATURE"; fi
  if [ -n "$TOP_P" ];       then sampling="${sampling:+$sampling, }\"top_p\": $TOP_P"; fi
  if [ -n "$TOP_K" ];       then sampling="${sampling:+$sampling, }\"top_k\": $TOP_K"; fi
  if [ -n "$sampling" ]; then
    extra=",
          \"samplingParams\": { $sampling }"
  fi
  cat <<EOF
{
  "providers": {
    "local": {
      "baseUrl": "$CONTAINER_BASE_URL",
      "api": "openai-completions",
      "apiKey": "$API_KEY",
      "models": [
        {
          "id": "$MODEL_ID",
          "name": "$MODEL_NAME",
          "reasoning": $REASONING,
          "input": $input,
          "contextWindow": $CONTEXT_WINDOW,
          "maxTokens": $MAX_TOKENS$extra
        }
      ]
    }
  }
}
EOF
}

write_agent_config() {
  mkdir -p "$AGENT_DIR"
  local tmp="$AGENT_DIR/.models.json.tmp"
  models_json > "$tmp"
  if command -v jq >/dev/null 2>&1; then
    jq empty "$tmp" 2>/dev/null || { rm -f "$tmp"; die "generated models.json is invalid (script bug)"; }
  fi
  mv -f "$tmp" "$AGENT_DIR/models.json"
  if [ ! -f "$AGENT_DIR/settings.json" ]; then
    printf '{\n  "enableInstallTelemetry": false\n}\n' > "$AGENT_DIR/settings.json"
  fi
}

# ---------------------------------------------------------------------------
# Container image
# ---------------------------------------------------------------------------
containerfile() {
  cat <<'EOF'
# Generated by pi-box: do NOT edit by hand, it is rewritten on every build.
# To add packages, use APT_EXTRA and PIP_PACKAGES in pi-box.conf.
ARG BASE_IMAGE=node:24-slim
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8

# --- Basic tools ---------------------------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ripgrep fd-find curl wget ca-certificates less procps file \
      unzip xz-utils jq \
 && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

# --- C / C++: compilers, build systems, debuggers, analysis, common libraries --
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential gdb cmake ninja-build pkg-config ccache \
      clang clang-format clang-tidy lldb valgrind \
      autoconf automake libtool \
      libboost-dev libeigen3-dev libfmt-dev libspdlog-dev nlohmann-json3-dev \
      libgtest-dev libgmock-dev libssl-dev zlib1g-dev libcurl4-openssl-dev \
      libsqlite3-dev libsdl2-dev \
 && rm -rf /var/lib/apt/lists/*

# --- Python with Debian's prebuilt libraries (no compiling) --------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-dev python3-venv python3-pip \
      python3-numpy python3-scipy python3-matplotlib python3-pandas \
      python3-sympy python3-sklearn python3-seaborn python3-networkx \
      python3-pygame python3-pil python3-requests python3-yaml \
      python3-bs4 python3-lxml python3-pytest python3-logzero \
 && rm -rf /var/lib/apt/lists/*

# --- Extra Debian packages (APT_EXTRA) ------------------------------------------
ARG APT_EXTRA=""
RUN set -f; if [ -n "$APT_EXTRA" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends $APT_EXTRA \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# --- Pi (--ignore-scripts: no npm install scripts are run) ---------------------
ARG PI_VERSION=latest
RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && npm cache clean --force

# --- Non-root user with the same UID as the host user ------------------------
# If the UID is already taken (e.g. user "node" with UID 1000), that user is removed.
ARG USER_UID=1000
RUN set -e; \
    old="$(getent passwd "$USER_UID" | cut -d: -f1)" || true; \
    if [ -n "$old" ] && [ "$old" != root ]; then userdel -r "$old" >/dev/null 2>&1 || true; fi; \
    if getent passwd "$USER_UID" >/dev/null; then \
      echo "UID $USER_UID is still in use" >&2; exit 1; \
    fi; \
    useradd -u "$USER_UID" -m -s /bin/bash dev

# --- Python virtual environment: sees the Debian libraries, accepts pip install --
RUN python3 -m venv --system-site-packages /opt/venv \
 && chown -R dev:dev /opt/venv \
 && printf '%s\n' 'export PATH="/opt/venv/bin:$PATH"' > /etc/profile.d/venv.sh

USER dev
ENV HOME=/home/dev \
    PATH=/opt/venv/bin:$PATH \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MPLBACKEND=Agg \
    SDL_VIDEODRIVER=dummy \
    SDL_AUDIODRIVER=dummy \
    PYGAME_HIDE_SUPPORT_PROMPT=1

# --- Extra pip packages (PIP_PACKAGES) ------------------------------------------
ARG PIP_PACKAGES=""
RUN set -f; if [ -n "$PIP_PACKAGES" ]; then pip install --no-cache-dir $PIP_PACKAGES; fi

WORKDIR /work
CMD ["pi"]
EOF
}

IMAGE_UID="$(id -u)"
if [ "$IMAGE_UID" -eq 0 ]; then
  IMAGE_UID=1000   # never create the container user with UID 0 (root)
fi

build_args() {
  printf '%s\n' \
    "BASE_IMAGE=$BASE_IMAGE" \
    "APT_EXTRA=$APT_EXTRA" \
    "PI_VERSION=$PI_VERSION" \
    "USER_UID=$IMAGE_UID" \
    "PIP_PACKAGES=$PIP_PACKAGES"
}

# Fingerprint of everything that determines the image
build_stamp() {
  { containerfile; build_args; printf 'runtime=%s image=%s\n' "$RT" "$IMAGE"; } | cksum | awk '{print $1 "-" $2}'
}

image_exists() {
  case "$RT" in
    container) container image inspect "$IMAGE" >/dev/null 2>&1 ;;
    podman)    podman image exists "$IMAGE" ;;
    docker)    docker image inspect "$IMAGE" >/dev/null 2>&1 ;;
  esac
}

# Prints why a build is needed, or nothing
build_reason() {
  if [ "$DO_REBUILD" = true ]; then echo "requested with --rebuild (from scratch, no cache)"; return; fi
  if ! image_exists; then echo "image $IMAGE not found"; return; fi
  if [ ! -f "$STAMP_FILE" ] || [ "$(cat "$STAMP_FILE")" != "$(build_stamp)" ]; then
    echo "Containerfile or packages changed"
  fi
}

build_image() {
  mkdir -p "$IMAGE_DIR"
  containerfile > "$IMAGE_DIR/Containerfile"
  local args=(build --tag "$IMAGE" --file "$IMAGE_DIR/Containerfile") line
  while IFS= read -r line; do args+=(--build-arg "$line"); done < <(build_args)
  if [ "$DO_REBUILD" = true ]; then
    local help
    help="$("$RT" build --help 2>&1 || true)"
    case "$help" in
      *--no-cache*) args+=(--no-cache) ;;
      *) info "warning: '$RT build' does not support --no-cache, using the cache" ;;
    esac
    case "$RT" in
      podman) args+=(--pull=always) ;;
      docker) args+=(--pull) ;;
    esac
  fi
  args+=("$IMAGE_DIR")
  info "building image $IMAGE with $RT: this may take a while..."
  rm -f "$STAMP_FILE"
  "$RT" "${args[@]}"
  build_stamp > "$STAMP_FILE"
  info "image $IMAGE ready"
}

# ---------------------------------------------------------------------------
# macOS-specific preparation
# ---------------------------------------------------------------------------
macos_prepare() {
  if ! container list >/dev/null 2>&1; then
    info "starting the container service..."
    container system start
  fi
  case "$CONTAINER_BASE_URL" in
    *://host.container.internal*)
      local domains
      domains="$(container system dns list 2>/dev/null || true)"
      if ! printf '%s\n' "$domains" | grep -Eq '^host\.container\.internal[[:space:]]*$'; then
        info "creating the host.container.internal domain (requires sudo; must be recreated after every Mac reboot)"
        sudo container system dns create host.container.internal --localhost 203.0.113.113
      fi ;;
  esac
}

# ---------------------------------------------------------------------------
# Resource limits on Linux
# ---------------------------------------------------------------------------
# Prints the cgroup v2 controllers available to containers, space-separated;
# prints nothing if they cannot be determined.
linux_cgroup_controllers() {
  local out="" f uid
  uid="$(id -u)"
  case "$RT" in
    podman)
      out="$(podman info --format '{{.Host.CgroupControllers}}' 2>/dev/null || true)"
      out="$(printf '%s' "$out" | tr -d '[]')"
      ;;
    docker)
      local mem cpu
      if read -r mem cpu < <(docker info --format '{{.MemoryLimit}} {{.CPUCfsQuota}}' 2>/dev/null) \
         && [ -n "${cpu:-}" ]; then
        out="pids"
        if [ "$mem" = true ]; then out="$out memory"; fi
        if [ "$cpu" = true ]; then out="$out cpu"; fi
      fi
      ;;
  esac
  if [ -z "$out" ]; then
    # rootless podman uses the controllers delegated by systemd to the user
    if [ "$RT" = podman ] && [ "$uid" -ne 0 ]; then
      f="$CGROUP_ROOT/user.slice/user-$uid.slice/user@$uid.service/cgroup.controllers"
    else
      f="$CGROUP_ROOT/cgroup.controllers"
    fi
    if [ -r "$f" ]; then out="$(cat "$f")"; fi
  fi
  printf '%s' "$out" | tr -s '[:space:]' ' '
}

add_linux_limits() {
  [ -n "$CPUS" ] || [ -n "$MEMORY" ] || return 0
  local ctrls
  ctrls=" $(linux_cgroup_controllers) "
  if [ -z "${ctrls// /}" ]; then
    info "warning: cannot check cgroups, applying the requested limits anyway"
    if [ -n "$CPUS" ];   then RUN_ARGS+=(--cpus "$CPUS"); fi
    if [ -n "$MEMORY" ]; then RUN_ARGS+=(--memory "$MEMORY" --memory-swap "$MEMORY"); fi
    return 0
  fi
  if [ -n "$CPUS" ]; then
    case "$ctrls" in
      *" cpu "*) RUN_ARGS+=(--cpus "$CPUS") ;;
      *) info "warning: the 'cpu' cgroup controller is not available: starting without a CPU limit (to silence this warning: CPUS=\"\" in $CONF_FILE)" ;;
    esac
  fi
  if [ -n "$MEMORY" ]; then
    case "$ctrls" in
      *" memory "*) RUN_ARGS+=(--memory "$MEMORY" --memory-swap "$MEMORY") ;;
      *) info "warning: the 'memory' cgroup controller is not available: starting without a memory limit (to silence this warning: MEMORY=\"\" in $CONF_FILE)" ;;
    esac
  fi
}

# ---------------------------------------------------------------------------
# Run command
# ---------------------------------------------------------------------------
RUN_ARGS=(run -it --rm)
if [ "$BUILD_ONLY" = false ]; then
  case "$RT" in
    podman) RUN_ARGS+=(--network host --userns=keep-id) ;;
    docker) RUN_ARGS+=(--network host) ;;
  esac
  if [ "$RT" = container ]; then
    # macOS: each container is a lightweight VM, limits always apply
    if [ -n "$CPUS" ];   then RUN_ARGS+=(--cpus "$CPUS"); fi
    if [ -n "$MEMORY" ]; then RUN_ARGS+=(--memory "$MEMORY"); fi
  else
    add_linux_limits
  fi
  RUN_ARGS+=(--volume "$AGENT_DIR:/home/dev/.pi/agent" --volume "$PROJECT:/work")
  if [ "$OFFLINE" = true ]; then RUN_ARGS+=(--env PI_OFFLINE=1); fi
  RUN_ARGS+=("$IMAGE")
  if [ "$DO_SHELL" = true ]; then
    RUN_ARGS+=(bash -l)
  else
    RUN_ARGS+=(pi --provider local --model "$MODEL_ID" --thinking "$THINKING")
    RUN_ARGS+=(${PI_ARGS[@]+"${PI_ARGS[@]}"})
  fi
fi

if [ "$DRY_RUN" = true ]; then
  info "pi-box $PI_BOX_VERSION, runtime: $RT"
  if [ "$BUILD_ONLY" = false ]; then
    info "project: $PROJECT -> /work"
    info "models.json that would be written to $AGENT_DIR:"
    models_json
  fi
  printf '\nbuild arguments:\n'
  build_args | sed 's/^/  /'
  if command -v "$RT" >/dev/null 2>&1; then
    reason="$(build_reason)"
    printf 'build: %s\n' "${reason:-not needed}"
  fi
  if [ "$BUILD_ONLY" = false ]; then
    printf '\ncommand:\n  %q' "$RT"
    for a in "${RUN_ARGS[@]}"; do printf ' %q' "$a"; done
    printf '\n'
  fi
  exit 0
fi

if [ "$RT" = container ]; then macos_prepare; fi

reason="$(build_reason)"
if [ -n "$reason" ]; then
  info "build needed: $reason"
  build_image
elif [ "$BUILD_ONLY" = true ]; then
  info "image $IMAGE is up to date"
fi
if [ "$BUILD_ONLY" = true ]; then exit 0; fi

write_agent_config
info "starting Pi ($MODEL_ID) on $PROJECT"
exec "$RT" "${RUN_ARGS[@]}"
