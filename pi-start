#!/usr/bin/env bash

set -euo pipefail

NODES_JSON="${HOME}/ai-console/nodes.json"
PIBOX_CMD="${PIBOX_CMD:-pi-box}"

# Default (usati se nodes.json manca o manca la voce per quel provider)
declare -A DEFAULT_PORT=(
    [llama]=11000
    [mlx]=8080
    [strata]=8091
    [splash]=10000
    [freetoken]=1919
)
declare -A DEFAULT_MODEL=(
    [llama]="llama-default"
    [mlx]="mlx-default"
    [strata]="strata-default"
    [splash]="splash-default"
    [freetoken]="freetoken-default"
)

VALID_PROVIDERS=(llama mlx strata splash freetoken)

usage() {
    echo "Usage: $0 [llama|mlx|strata|splash|freetoken] [...]" >&2
    echo "Available providers: ${VALID_PROVIDERS[*]}" >&2
    exit 1
}

[ $# -ge 1 ] || usage
for a in "$@"; do
    ok=0
    for p in "${VALID_PROVIDERS[@]}"; do
        [ "$a" = "$p" ] && ok=1
    done
    [ $ok -eq 1 ] || { echo "Invalid Provider: $a" >&2; usage; }
done

port=$(jq ".NODES[\"$1\"].api_port" "$NODES_JSON")
model=$(curl -k http://localhost:$port/v1/models|jq '.data[0].id'|sed 's+\"++g')
if [ "$1" = "mlx" ]; then
    reasoning=off
    #ctx="131072"
else
    reasoning=on
    #ctx="262144"
fi

echo "Running pi-box -u http://localhost:$port/v1 -c 262144 -o 131072 -t medium -r $reasoning -m $model"

pi-box -u http://localhost:$port/v1 -c 262144 -o 131072 -t medium -r "$reasoning" -m "$model"
