#!/usr/bin/env bash
# Avvia pi-box verso un provider locale.
# Uso: run-pibox.sh <provider> [-temp <float>]

set -euo pipefail

NODES_JSON="${HOME}/ai-console/nodes.json"
PIBOX_CMD="${PIBOX_CMD:-pi-box}"

# Default (usati se nodes.json manca o manca la voce per quel provider)
declare -A DEFAULT_PORT=(
    [llama-linux]=11000
    [llama-macos]=9088
    [mlx]=8080
    [strata]=8000
    [splash]=10000
    [freetoken]=1919
)
declare -A DEFAULT_MODEL=(
    [llama-linux]="llama-linux-default"
    [llama-macos]="llama-macos-default"
    [mlx]="mlx-default"
    [strata]="strata-default"
    [splash]="splash-default"
    [freetoken]="freetoken-default"
)

VALID_PROVIDERS=(llama mlx strata splash freetoken)

usage() {
    echo "Usage: $0 <provider> [-temp <float>]" >&2
    echo "Available providers: ${VALID_PROVIDERS[*]}" >&2
    exit 1
}

die() {
    echo "Error: $*" >&2
    exit 1
}

is_valid_provider() {
    local p
    for p in "${VALID_PROVIDERS[@]}"; do
        [[ "$1" == "$p" ]] && return 0
    done
    return 1
}

for bin in jq curl "$PIBOX_CMD"; do
    command -v "$bin" >/dev/null 2>&1 || die "'$bin' not found in PATH"
done

# --- Parsing argomenti -------------------------------------------------------
provider=""
temp=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -temp|--temp)
            [[ -n "${2-}" ]] || die "option $1 requires a value"
            temp="$2"
            shift 2
            ;;
        -temp=*|--temp=*)
            temp="${1#*=}"
            [[ -n "$temp" ]] || die "option ${1%%=*} requires a value"
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            ;;
        *)
            is_valid_provider "$1" || { echo "Invalid provider: $1" >&2; usage; }
            [[ -z "$provider" ]] || die "only one provider allowed (got '$provider' and '$1')"
            provider="$1"
            shift
            ;;
    esac
done

[[ -n "$provider" ]] || usage

if [[ -n "$temp" ]]; then
    temp="${temp/,/.}"   # accetta anche la virgola decimale (0,7 -> 0.7)
    [[ "$temp" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] \
        || die "-temp must be a non-negative number, got '$temp'"
fi

# --- Porta: da nodes.json, altrimenti default ---------------------------------
port=""
if [[ -r "$NODES_JSON" ]]; then
    port=$(jq -r --arg p "$provider" '.NODES[$p].api_port // empty' "$NODES_JSON") \
        || die "cannot parse $NODES_JSON"
fi
port="${port:-${DEFAULT_PORT[$provider]}}"
[[ "$port" =~ ^[0-9]+$ ]] || die "invalid port '$port' for provider '$provider'"

base_url="http://localhost:${port}/v1"

# --- Modello: dal server, altrimenti default ----------------------------------
models_json=$(curl -fsS --max-time 10 "${base_url}/models") \
    || die "server not reachable at ${base_url}/models"
model=$(jq -r '.data[0].id // empty' <<<"$models_json" 2>/dev/null || true)
if [[ -z "$model" ]]; then
    echo "Warning: no model id from ${base_url}/models, using default" >&2
    model="${DEFAULT_MODEL[$provider]}"
fi

if [[ "$provider" == "mlx" ]]; then
    reasoning=off
else
    reasoning=on
fi

# --- Costruzione ed esecuzione comando ----------------------------------------
cmd=("$PIBOX_CMD" -u "$base_url" -c 262144 -o 131072 -t medium -r "$reasoning" -m "$model")
if [[ -n "$temp" ]]; then
    cmd+=(--temperature "$temp")
fi
cmd+=(-n "$provider - $model")

printf 'Running:'
printf ' %q' "${cmd[@]}"
printf '\n'

exec "${cmd[@]}"
