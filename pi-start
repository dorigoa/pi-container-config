#!/usr/bin/env bash
# Avvia pi-box verso un provider locale.
# Uso: run-pibox.sh <provider> [-temp <float>] [-c|--context-size <int>] [-o|--max-tokens <int>] [-e|--endpoint <hostname:port>]

set -euo pipefail

NODES_JSON="${HOME}/ai-console/nodes.json"
PIBOX_CMD="${PIBOX_CMD:-pi-box}"

# Default (usati se nodes.json manca o manca la voce per quel provider)
declare -A DEFAULT_PORT=(
    [llama-linux]=8080
    [mlx]=8080
    [strata]=8000
    [splash]=10000
    [freetoken]=1919
)
declare -A DEFAULT_MODEL=(
    [llama-linux]="llama-linux-default"
    [mlx]="mlx-default"
    [strata]="strata-default"
    [splash]="splash-default"
    [freetoken]="freetoken-default"
)

VALID_PROVIDERS=(llama-linux llama-macos mlx strata splash freetoken)

usage() {
    echo "Usage: $0 <provider> [-temp <float>] [-c <context-size>] [-o <max-tokens>] [-e <endpoint>]" >&2
    echo "  -c, --context-size <int>  context size (default 81920)" >&2
    echo "  -o, --max-tokens <int>    max output tokens (default 65536)" >&2
    echo "  -e, --endpoint <host:port> LLM endpoint override (default: from nodes.json/local port)" >&2
    echo "Available providers: ${VALID_PROVIDERS[*]}" >&2
    exit 1
}

die() {
    echo "Error: $*" >&2
    exit 1
}

is_valid_provider() {
    local p
    for p in "${VALID_PROVIDERS[@]}"; do
        [[ "$1" == "$p" ]] && return 0
    done
    return 1
}

for bin in jq curl "$PIBOX_CMD"; do
    command -v "$bin" >/dev/null 2>&1 || die "'$bin' not found in PATH"
done

# --- Parsing argomenti -------------------------------------------------------
provider=""
temp=""
context_size=""
max_tokens=""
endpoint=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -temp|--temp)
            [[ -n "${2-}" ]] || die "option $1 requires a value"
            temp="$2"
            shift 2
            ;;
        -temp=*|--temp=*)
            temp="${1#*=}"
            [[ -n "$temp" ]] || die "option ${1%%=*} requires a value"
            shift
            ;;
        -c|--context-size)
            [[ -n "${2-}" ]] || die "option $1 requires a value"
            context_size="$2"
            shift 2
            ;;
        -c=*|--context-size=*)
            context_size="${1#*=}"
            [[ -n "$context_size" ]] || die "option ${1%%=*} requires a value"
            shift
            ;;
        -o|--max-tokens)
            [[ -n "${2-}" ]] || die "option $1 requires a value"
            max_tokens="$2"
            shift 2
            ;;
        -o=*|--max-tokens=*)
            max_tokens="${1#*=}"
            [[ -n "$max_tokens" ]] || die "option ${1%%=*} requires a value"
            shift
            ;;
        -e|--endpoint)
            [[ -n "${2-}" ]] || die "option $1 requires a value"
            endpoint="$2"
            shift 2
            ;;
        -e=*|--endpoint=*)
            endpoint="${1#*=}"
            [[ -n "$endpoint" ]] || die "option ${1%%=*} requires a value"
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            ;;
        *)
            is_valid_provider "$1" || { echo "Invalid provider: $1" >&2; usage; }
            [[ -z "$provider" ]] || die "only one provider allowed (got '$provider' and '$1')"
            provider="$1"
            shift
            ;;
    esac
done

[[ -n "$provider" ]] || usage

if [[ -n "$temp" ]]; then
    temp="${temp/,/.}"   # accetta anche la virgola decimale (0,7 -> 0.7)
    [[ "$temp" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] \
        || die "-temp must be a non-negative number, got '$temp'"
fi

[[ -z "$context_size" || ("$context_size" =~ ^[0-9]+$ && "$context_size" -gt 0) ]] \
    || die "--context-size must be a positive integer, got '$context_size'"
[[ -z "$max_tokens" || ("$max_tokens" =~ ^[0-9]+$ && "$max_tokens" -gt 0) ]] \
    || die "--max-tokens must be a positive integer, got '$max_tokens'"
context_size="${context_size:-81920}"
max_tokens="${max_tokens:-65536}"

# --- Endpoint: da riga di comando, altrimenti porta da nodes.json/default -----
if [[ -n "$endpoint" ]]; then
    [[ "$endpoint" =~ ^[A-Za-z0-9._-]+:[0-9]+$ ]] \
        || die "-e/--endpoint must be hostname:port, got '$endpoint'"
    base_url="http://${endpoint}/v1"
else
    port=""
    if [[ -r "$NODES_JSON" ]]; then
        port=$(jq -r --arg p "$provider" '.NODES[$p].api_port // empty' "$NODES_JSON") \
            || die "cannot parse $NODES_JSON"
    fi
    port="${port:-${DEFAULT_PORT[$provider]}}"
    [[ "$port" =~ ^[0-9]+$ ]] || die "invalid port '$port' for provider '$provider'"

    base_url="http://localhost:${port}/v1"
fi

# --- Modello: dal server, altrimenti default ----------------------------------
models_json=$(curl -fsS --max-time 10 "${base_url}/models") \
    || die "server not reachable at ${base_url}/models"
model=$(jq -r '.data[0].id // empty' <<<"$models_json" 2>/dev/null || true)
if [[ -z "$model" ]]; then
    echo "Warning: no model id from ${base_url}/models, using default" >&2
    model="${DEFAULT_MODEL[$provider]}"
fi

if [[ "$provider" == "mlx" ]]; then
    reasoning=off
else
    reasoning=on
fi

# --- Costruzione ed esecuzione comando ----------------------------------------
cmd=("$PIBOX_CMD" -u "$base_url" -c "$context_size" -o "$max_tokens" -t medium -r "$reasoning" -m "$model")
if [[ -n "$temp" ]]; then
    cmd+=(--temperature "$temp")
fi
cmd+=(-n "$provider - $model")

printf 'Running:'
printf ' %q' "${cmd[@]}"
printf '\n'

exec "${cmd[@]}"
